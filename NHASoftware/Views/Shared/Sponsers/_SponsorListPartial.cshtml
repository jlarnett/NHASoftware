@using NHA.Website.Software.FeatureManagement
@using NHA.Website.Software.Services.RepositoryPatternFoundationals
@using NHA.Website.Software.Services.Sponsors
@using NHA.Website.Software.Views.Shared.Sponsers.ViewModel
@inject IAdMaximizerService AdMaximizerService
@inject IUnitOfWork UnitOfWork

@{
    var randomAnime = await UnitOfWork.AnimePageRepository.GetRandomEntityAsync();
}

@{
    var featuredAnime = (await UnitOfWork.AnimePageRepository.FindAsync(a => a.Featured)).FirstOrDefault();
}

@{
    <div id="SponsorListUI" class="col position-fixed pb-5 mx-auto overflow-scroll w-inherit" style="height: 100%;">
    
        @if (featuredAnime is not null)
        {
            <div class="row">
                <div class="mb-3 pb-2 border-bottom border-1 border-light-subtle">
                    <span class="text-uppercase small fw-bold tracking-wider text-primary">Editor's Choice</span>
                </div>
            </div>
        
            <div class="row m-auto pt-1 pb-1 text-center">
                <div class="">
                    <a class="row text-center m-auto rounded-2 interactable w-100" asp-controller="Anime" asp-action="AnimePageDetails" asp-route-id="@featuredAnime.Id">
                        <img src="@featuredAnime.AnimeImageUrl" class="rounded-3 p-0" title="@featuredAnime.AnimeName" alt="@featuredAnime.AnimeName's cover photo" />
                    </a>
                </div>
                <a asp-action="AnimePageDetails" class="h5 text-body text-decoration-none interactable fw-semibold" asp-controller="Anime" asp-route-id="@featuredAnime.Id">@featuredAnime.AnimeName</a>
                <div class="multiline-ellipsis expandable-ellipsis interactable-small"
                     style="max-width: 350px;"
                     role="button"
                     tabindex="0"
                     aria-expanded="false"
                     title="Click to expand or collapse">
                    @Html.Raw(@featuredAnime.AnimeSummary)
                    @Html.Raw(@featuredAnime.AnimeBackground)
                </div>
                @{ await Html.RenderPartialAsync("Sponsers/_GenreListPartial", new GenreListVm(@featuredAnime.AnimeGenres ?? string.Empty, GenreListType.Anime)); }
                <div class="row mt-2 me-2"></div>
                @{ await Html.RenderPartialAsync("Sponsers/_GenreListPartial", new GenreListVm(@featuredAnime.Platforms ?? string.Empty, GenreListType.StreamingPlatform)); }
                <div><strong>Score:</strong> @featuredAnime.AnimeJikanScore/10</div>

            </div>
        }
        
        <a class="btn btn-outline-primary w-100 mb-2"
           asp-area="" asp-controller="Anime" asp-action="Index" asp-route-pageNumber="1">
            <i class="bi bi-card-text"></i> Wiki
        </a>

        <a class="btn btn-outline-primary w-100 mb-2"
           asp-area="" asp-controller="Anime" asp-action="Roll" asp-route-pageNumber="1">
            <i class="bi bi-youtube"></i> Feed
        </a>
        
        <a class="btn btn-outline-primary w-100 mb-2"
           asp-area="" asp-controller="Anime" asp-action="AnimePageDetails" asp-route-id="@randomAnime!.Id">
            <i class="bi bi-shuffle"></i> Random
        </a>
        <a class="btn btn-outline-primary w-100 mb-2"
           asp-area="" asp-controller="Anime" asp-action="Rankings">
            <i class="bi bi-bar-chart"></i> Rankings
        </a>

        <div class="row">
            <div class="mb-3 pb-2 border-bottom border-1 border-light-subtle">
                <span class="text-uppercase small fw-bold tracking-wider text-primary">Top 10</span>
            </div>
        </div>
        @{
            var topTen = await UnitOfWork.AnimePageRepository.GetAllAsync();
            topTen = topTen.OrderByDescending(a => a.AnimeJikanScore).Take(10).ToList();
        }

        @if (topTen.Any())
        {
            <ol class="list-group list-group-numbered d-flex flex-column gap-2 mb-4 w-100">
                @foreach (var anime in topTen)
                {
                    <li class="list-group-item bg-body-secondary rounded-3 px-3 py-2 border border-secondary-subtle shadow-sm position-relative interactable-small">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="me-2">
                                <a class="text-body text-decoration-none fw-semibold stretched-link"
                                   asp-controller="Anime"
                                   asp-action="AnimePageDetails"
                                   asp-route-id="@anime.Id">
                                    @anime.AnimeName
                                </a>
                            </div>
                            <span class="badge text-bg-primary rounded-pill position-relative">@anime.AnimeJikanScore/10</span>
                        </div>
                    </li>
                }
            </ol>
        }

        <div class="row">
            <div class="mb-3 pb-2 border-bottom border-1 border-light-subtle">
                <span class="text-uppercase small fw-bold tracking-wider text-primary">Partnerships</span>
            </div>
        </div>

        @{
            var ads = await AdMaximizerService.GetBestAdsForUserAsync();

            foreach (var ad in ads)
            {

                if (ad.VideoUrl != null)
                {
                    <feature name="@FeatureFlags.SponsorAdsEnabled">
                        <div class="row m-auto pt-1 pb-1 text-center">
                            <div class="col">
                                <div class="ratio ratio-16x9 rounded-2 overflow-hidden">
                                    <iframe src="@ad.VideoUrl"
                                            title="YouTube video"
                                            allowfullscreen
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
                                    </iframe>
                                </div>
                            </div>
                        </div>
                    </feature>
                }

                if (ad.ImageUrl != null)
                {
                    <div class="row m-auto pt-1 pb-1 text-center">
                        <iframe src=@ad.ImageUrl
                                title="Sponsor Video"
                                height="350px"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen>
                        </iframe>
                    </div>
                }
            }
        }
        <div class="row m-auto pt-1 pb-1">
            <p>Huge shoutout to all of our sponsors for supporting the site, it wouldn't be possible without you.</p>
            <p>if you would like your channel, product, or video promoted or featured click <a asp-controller="Home" asp-action="Index" class="link-primary">here</a>.</p>
        </div>

        <a href="https://www.flaticon.com/free-icons/ui" title="ui icons">Ui icons created by The Icon Tree - Flaticon</a>
    </div>
}
