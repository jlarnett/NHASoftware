@using HtmlAgilityPack
@using Microsoft.AspNetCore.Identity
@using Microsoft.IdentityModel.Tokens
@using NHA.Website.Software.Entities.Identity
@using NHA.Website.Software.Services.Social.PostBuilderService
@using NHA.Website.Software.Services.Time
@model NHA.Website.Software.ConsumableEntities.DTOs.PostDTO
@inject SignInManager<ApplicationUser> _SignInManager
@inject ITimeBender _TimeBender
@inject IPostBuilder _PostBuilder

@*
    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    Model.UUID = Guid.NewGuid();
    string uuid = Model.UUID.Value.ToString();
}

@{
    var shareUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}#post-{Model.Id}";
    var shareText = $"Check out this post from {Model.User!.DisplayName} on Anime Social";
    var encodedShareUrl = Uri.EscapeDataString(shareUrl);
    var encodedShareText = Uri.EscapeDataString(shareText);
    var lastSessionActivityDate = Model.UserLastActiveTime;
    var isUserOnline = lastSessionActivityDate.HasValue && (DateTime.UtcNow - lastSessionActivityDate.Value).TotalMinutes < 10;
    var profileOutlineClass = isUserOnline ? "border-success" : "border-secondary-subtle";
    var profileStatusLabel = isUserOnline ? "Online" : "Offline";
}

<div id="post-@Model.Id" class="container-fluid border border-1 shadow-sm border-dark ridge rounded-2 mt-2 post-container" post-id="@Model.Id" images-attached="@Model.HasImagesAttached.ToString()" images-loaded="false" post-uuid="@uuid.ToString()" post-container-id="@Model.Id">
    <div class="row align-items-center mt-2">
        <!--User Profile image & display name-->
        <div class="col-auto px-2">
            <a asp-controller="Users" asp-action="GetProfiles" asp-route-userId="@Model.User!.Id" class="shadow">
                <img src="/ProfilePictures/@Model.User!.ProfilePicturePath" class="avatar interactable shadow border border-2 @profileOutlineClass" alt="@Model.User!.DisplayName Profile Picture" title="@profileStatusLabel"/>
            </a>
        </div>
        <div class="col-auto">
            <a class="h5 text-decoration-none profile-link fw-semibold interactable" role="button" userId="@Model.UserId">@Model.User!.DisplayName</a>
            <div class="">
                <a class="text-decoration-none" role="button">@_TimeBender.GetTimeShortHandString(@Model.CreationDate!.Value)</a>
            </div>
        </div>
        <div class="col">
        </div>
        <!--Post Action dropdown-->
        <div class="col-auto p-0">
            @{
                await Html.RenderPartialAsync("Social/_PostActionButtonSection", @Model);
                bool isCommentBool = Model.ParentPostId != null;
            }
        </div>
        <div class="col-auto p-0">
            <a class="btn btn-sm border-0 bg-transparent text-muted fs-5 interactable hide-post-link py-2">
                <i class="bi bi-x-lg " post-id="@Model.Id" title="Hide"
                   is-comment="@isCommentBool.ToString()"
                   uuid="@Model.UUID"></i>
            </a>
        </div>

        <div class="col-auto p-0 me-1 dropdown">
            <button class="btn btn-sm border-0 bg-transparent text-muted fs-5 interactable py-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Share">
                <i class="bi bi-share"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li>
                    <button class="dropdown-item native-share-link" type="button" data-share-title="@shareText" data-share-url="@shareUrl">
                        <i class="bi bi-share me-2" aria-hidden="true"></i>Share...
                    </button>
                </li>
                <li>
                    <button class="dropdown-item copy-share-link" type="button" data-share-url="@shareUrl">
                        <i class="bi bi-link-45deg me-2" aria-hidden="true"></i>Copy link
                    </button>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="https://twitter.com/intent/tweet?url=@encodedShareUrl&text=@encodedShareText" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-twitter-x me-2" aria-hidden="true"></i>Share to X
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="https://www.facebook.com/sharer/sharer.php?u=@encodedShareUrl" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-facebook me-2" aria-hidden="true"></i>Share to Facebook
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedShareUrl" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-linkedin me-2" aria-hidden="true"></i>Share to LinkedIn
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="https://www.reddit.com/submit?url=@encodedShareUrl&title=@encodedShareText" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-reddit me-2" aria-hidden="true"></i>Share to Reddit
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="mailto:?subject=@encodedShareText&body=@encodedShareUrl">
                        <i class="bi bi-envelope me-2" aria-hidden="true"></i>Share by Email
                    </a>
                </li>
            </ul>
        </div>
    </div>
    @*     <div class="row">
        <div class="col-sm-1 px-0"></div>
        <div class="col">
            <div class="h4 text-primary">Summary</div>
        </div>
    </div> *@

    <!--Posts summary section. Text content is posted here-->
    <div class="row text-break mb-2 ">
        <div class="col pt-2">
            <div class="col">
                @{
                    var doc = new HtmlDocument();
                    doc.LoadHtml(@Model.Summary);

                    IEnumerable<string> taggedObjectHref = [];
                    IEnumerable<string> taggedObjectImages = [];

                    if (Model.Summary.Contains("image-url"))
                    {
                        taggedObjectHref = doc.DocumentNode.SelectNodes("//a")
                            .Select(a => a.GetAttributeValue("href", ""));
                        taggedObjectImages = doc.DocumentNode.SelectNodes("//a")
                            .Select(a => a.GetAttributeValue("image-url", ""));

                    }
                    var objectHref = taggedObjectHref as string[] ?? taggedObjectHref.ToArray();
                    var objectImages = taggedObjectImages as string[] ?? taggedObjectImages.ToArray();

                    <div class="row p-1">
                        @Html.Raw(Model.Summary)
                    </div>

                    if (objectImages.Any())
                    {
                        <div class="row rounded-2">
                            @{
                                var counter = 0;
                                foreach (var imageUrl in objectImages)
                                {
                                    if(imageUrl.IsNullOrEmpty()) continue;
                                    <div class="col">
                                        <a class="row text-center m-auto rounded-2 interactable" href="@objectHref[counter]">
                                            <img src="@imageUrl" class="rounded-3 p-0" alt="Post Tag ImageUrl" />
                                        </a>
                                    </div>

                                    counter++;
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="row text-break">
        <div unique-image-section="@uuid" class="col">
            <div id="Image-Carousel-@uuid" class="carousel slide border border-white" data-bs-interval="false" style="display: none">
                <div class="carousel-inner" id="Image-Carousel-Inner-@uuid">
                </div>
                <button class="carousel-control-prev bg-black" type="button" data-bs-target="#Image-Carousel-@uuid" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next bg-black" type="button" data-bs-target="#Image-Carousel-@uuid" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </div>
    <!--Posts Likes & Comment Show section-->
    <div class="row align-items-center m-2">
        <div class="col-auto me-2">
            @{
                var commentCount = Model.CommentCount;
            }

            <a class="text-nowrap hide-comments interactable" comment-count="@commentCount" unique-post-id="@uuid.ToString()" post-id="@Model.Id" role="button">Show Comments (@commentCount)</a>
        </div>
        @{ await Html.RenderPartialAsync("Social/_PostLikeSection", @Model); }
    </div>

    <hr />


    <div unique-comment-section="@uuid.ToString()" style="display: none">

        @if(commentCount > 0)
        {
            <h4 class="community-discussion-header d-flex align-items-center justify-content-center gap-2 text-body-emphasis fw-semibold border-bottom border-2 pb-2 mb-3">
                <i class="bi bi-chat text-body-secondary" aria-hidden="true"></i>
                <span>Community Discussion</span>
            </h4>
        }

        <ul unique-comment-list="@uuid.ToString()" class="list-unstyled comment-thread-list">
        </ul>
        <form method="post" enctype="multipart/form-data" comment-form-uuid="@uuid.ToString()">
            @{
                if (_SignInManager.IsSignedIn(User))
                {
                    <div class="comment-composer mt-3 mb-2">
                        <div class="comment-composer-shell border border-1 rounded-3 p-2 p-md-3">
                            <div class="comment-composer-editor-wrap mb-2">
                                <textarea class="summernote-comments text-black" post-id="@Model.Id" comment-textbox-uuid="@uuid.ToString()" name="Summary"></textarea>
                            </div>

                            <div class="comment-composer-actions d-flex justify-content-end">
                                <button type="button" class="btn btn-primary rounded-3 px-4 comment-send-btn interactable d-inline-flex align-items-center gap-2" unique-identifier="@uuid.ToString()" parent-post-id="@Model.Id">
                                    <i class="bi bi-send-fill"></i>
                                    <span>Reply</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </form>
    </div>
    <span unique-error-identifier="@uuid.ToString()" data-testid="post-error-message" style="display: none;" class="text-primary">Error Submitting Post.....</span>
</div>
