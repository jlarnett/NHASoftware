@using Microsoft.AspNetCore.Identity
@using NHA.Website.Software.Entities.Identity
@using NHA.Website.Software.Services.AccessWarden
@model NHA.Website.Software.ConsumableEntities.DTOs.PostDTO
@inject UserManager<ApplicationUser> _UserManager
@inject IWarden _Warden

@{
    bool isCommentBool = Model.ParentPostId != null;
    var userId = (await _UserManager.GetUserAsync(User))?.Id ?? "-1";
    bool isLoggedInUsersPost = Model.User!.Id == userId;
    var menuButtonId = $"postMenuButton-{Model.Id}-{Model.UUID}";

    if (User.Identity!.IsAuthenticated)
    {
            <button class="btn btn-sm border-0 bg-transparent text-muted fs-5 dropstart interactable site-icon-btn" title="Options" type="button" id="@menuButtonId" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Post options">
                <i class="bi bi-three-dots-vertical fs-5 text-muted"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-sm shadow-lg border-0 rounded-4 p-2" aria-labelledby="@menuButtonId">
                @if (isLoggedInUsersPost || _Warden.IsAdmin(User))
                {
                    <li>
                        <a class="dropdown-item delete-post-link d-flex align-items-center gap-2 rounded-3"
                           post-id="@Model.Id"
                           is-comment="@isCommentBool.ToString()"
                           uuid="@Model.UUID">
                            <i class="bi bi-trash"></i>
                            <span>Delete</span>
                        </a>
                    </li>
                }
                <li>
                    <a class="dropdown-item report-post-link d-flex align-items-center gap-2 rounded-3"
                       data-bs-toggle="modal" data-bs-target="#reportPostModal" data-postid="@Model.Id"
                       uuid="@Model.UUID">
                        <i class="bi bi-flag"></i>
                        <span>Report</span>
                    </a>
                </li>
            </ul>
    }
}
