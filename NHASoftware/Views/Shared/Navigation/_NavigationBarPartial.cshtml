@using Microsoft.AspNetCore.Identity
@using NHA.Website.Software.Entities.Identity
@using NHA.Website.Software.FeatureManagement
@using NHA.Website.Software.Services.AccessWarden
@using NHA.Website.Software.Services.FriendSystem

@inject UserManager<ApplicationUser> UserManager
@inject IFriendSystem FriendSystem
@inject IWarden Warden
@inject SignInManager<ApplicationUser> SignInManager

<!--Navigation Bar-->
<nav class="navbar navbar-expand-sm border-bottom bg-body-tertiary box-shadow fixed-top p-0 site-navbar" aria-label="Main navigation">
    <div class="container-fluid px-2 px-lg-3">

        <button class="navbar-toggler btn-dark interactable mobile-nav-toggle border border-secondary-subtle shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation" style="font-size:2rem; padding:1rem; min-width: 100px;">
            <i class="bi bi-chevron-down text-primary"></i>
        </button>

        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-sm-center" id="navbarSupportedContent">
            <ul class="navbar-nav align-items-stretch gap-2 py-2 py-sm-0">
                <li class="nav-item align-self-center interactable w-100 w-sm-auto">
                    <a class="nav-link btn-dark text-light rounded-2 h5 m-0 d-block text-center text-nowrap main-nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door-fill"></i>
                        Home
                    </a>
                </li>
                <feature name="@FeatureFlags.AnimeEnabled">
                    <li class="nav-item dropdown align-self-center w-100 w-sm-auto interactable">
                        <a class="nav-link dropdown-toggle btn-dark text-light rounded-2 h5 m-0 d-block text-center main-nav-link"
                           href="#"
                           id="animeDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <i class="bi bi-stars"></i>
                            Anime
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark text-center rounded-4 border-0 shadow-lg p-2" aria-labelledby="animeDropdown">
                            <li>
                                <a class="dropdown-item d-flex align-items-center justify-content-center gap-2" asp-area="" asp-controller="Anime" asp-action="Index"><i class="bi bi-card-text"></i><span>Wiki</span></a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center justify-content-center gap-2" asp-area="" asp-controller="Anime" asp-action="Roll"><i class="bi bi-shuffle"></i><span>Trailer Roll</span></a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center justify-content-center gap-2" asp-area="" asp-controller="Anime" asp-action="Rankings"><i class="bi bi-bar-chart"></i><span>Rankings</span></a>
                            </li>
                        </ul>
                    </li>

                </feature>
                <feature name="@FeatureFlags.GameWikiEnabled">
                    <li class="nav-item dropdown align-self-center w-100 w-sm-auto interactable">
                        <a class="nav-link dropdown-toggle btn-dark text-light rounded-2 h5 m-0 d-block text-center main-nav-link"
                           href="#"
                           id="gamesDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <i class="bi bi-controller"></i>
                            Games
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark text-center rounded-4 border-0 shadow-lg p-2" aria-labelledby="gamesDropdown">
                            <li>
                                <a class="dropdown-item d-flex align-items-center justify-content-center gap-2" asp-area="" asp-controller="Game" asp-action="Index"><i class="bi bi-card-text"></i><span>Wiki</span></a>
                            </li>
                        </ul>
                    </li>
                </feature>

                <feature name="@FeatureFlags.ForumsEnabled">
                    <li class="nav-item align-self-center interactable w-100 w-sm-auto">
                        <a class="nav-link btn-dark text-light rounded-2 h5 m-0 d-block text-center text-nowrap main-nav-link" asp-area="" asp-controller="Forum" asp-action="Index">
                            <i class="bi bi-chat-dots"></i>
                            Forums
                        </a>
                    </li>
                </feature>

                <feature name="@FeatureFlags.CryptoEnabled">
                    <li class="nav-item align-self-center interactable w-100 w-sm-auto">
                        <a class="nav-link btn-dark text-light rounded-2 h5 m-0 d-block text-center text-nowrap main-nav-link" asp-area="" asp-controller="Crypto" asp-action="Index">
                            <i class="bi bi-currency-bitcoin"></i>
                            Crypto
                        </a>
                    </li>
                </feature>

                @if (Warden.IsAdmin(User))
                {
                    <li class="nav-item align-self-center interactable w-100 w-sm-auto">
                        <a class="nav-link btn-dark text-light rounded-2 h5 m-0 d-block text-center text-nowrap main-nav-link" asp-area="" asp-controller="Administration" asp-action="Users">
                            <i class="bi bi-people-fill"></i>
                            Users
                        </a>
                    </li>

                    <li class="nav-item align-self-center interactable w-100 w-sm-auto">
                        <a class="nav-link btn-dark text-light rounded-2 h5 m-0 d-block text-center text-nowrap main-nav-link" asp-area="" asp-controller="Administration" asp-action="CreateRole">
                            <i class="bi bi-person-plus"></i>
                            Create Role
                        </a>
                    </li>
                }

                <li class="nav-item dropdown align-self-center interactable w-100 w-sm-auto">
                    <a class="nav-link dropdown-toggle btn-dark text-light rounded-2 h5 m-0 d-block text-center main-nav-link" id="themeDropdown"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        <i class="bi bi-palette-fill"></i>
                        Theme
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-center rounded-4 border-0 shadow-lg p-2">
                        <li>
                            <button class="dropdown-item d-flex align-items-center justify-content-center gap-2 rounded-3" type="button" id="navbar-theme-light" onclick="setTheme('light')"><i class="bi bi-sun-fill"></i><span>Light Mode</span></button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center justify-content-center gap-2 rounded-3" type="button" id="navbar-theme-dark" onclick="setTheme('dark')"><i class="bi bi-moon-stars-fill"></i><span>Dark Mode</span></button>
                        </li>
                    </ul>
                </li>

                @{
                    //Returns IEnumerable list of all pending FriendRequestDTOs
                    var requests = await FriendSystem.GetPendingFriendRequestsAsync(UserManager.GetUserId(User)!);

                    if (SignInManager.IsSignedIn(User))
                    {

                        <li class="align-self-center nav-item interactable">
                            <button type="button" title="Notifications" aria-label="Open notifications" class="btn btn-dark position-relative d-flex align-items-center justify-content-center p-1 rounded mobile-nav-button site-icon-btn shadow-sm" data-bs-toggle="modal" data-bs-target="#friendRequestModal" style="min-width:50px; min-height:50px;">
                                <i class="bi bi-bell-fill fs-5"></i>
                                <span id="FriendRequestCounter" class="position-absolute top-100 start-100 translate-middle badge rounded-pill bg-primary">
                                    @requests.Count()
                                </span>
                            </button>
                        </li>
                    }
                }
                <li class="nav-item align-self-center w-100 w-sm-auto"></li>

            </ul>
            @{ await Html.RenderPartialAsync("Navigation/_LoginPartial");}
        </div>
    </div>
</nav>

<!--Navigation Bar Friend Request Popup Modal-->
@if (User.Identity!.IsAuthenticated)
{
    <div class="container-fluid ">
        <div class="row align-items-center bg-primary">
            <!--Friend Requests Modal-->
            <div class="modal fade" id="friendRequestModal" tabindex="-1" role="dialog" aria-labelledby="friendModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header border-bottom justify-content-between">
                            <h5 class="modal-title" id="friendModalLabel">Friend Requests</h5>
                            <button type="button" class="close text-primary-emphasis" data-bs-dismiss="modal" aria-label="Close" style="font-size: 2rem;">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            @foreach (var item in @requests)
                            {
                                <div class="row border-bottom p-2" friend-request-id="@item.Id">
                                    <div class="col-2">
                                        <img src="~/ProfilePictures/@item.SenderUser!.ProfilePicturePath" class="img-fluid" />
                                    </div>
                                    <p class="col-auto"><a href="~/Users/GetProfiles?userId=@item.SenderUser.Id">@item.SenderUser.DisplayName</a> wants to be your friend!</p>
                                    <div class="col-2">
                                        <button class="accept-friend-request-btn btn-dark col-auto" request-id="@item.Id">Accept</button>
                                        <button class="decline-friend-request-btn btn-dark col-auto" request-id="@item.Id">Decline</button>
                                    </div>
                                </div>

                            }
                            @if (!requests.Any())
                            {
                                <div>
                                    No more friend requests! Go add more people! :)
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col"></div>
    </div>
}

<!--Report Post Modal-->
@if (User.Identity!.IsAuthenticated)
{
    <div class="container-fluid ">
        <div class="row align-items-center bg-primary">
            <!--Friend Requests Modal-->
            <div class="modal fade" id="reportPostModal" tabindex="-1" role="dialog" aria-labelledby="reportPostLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header border-bottom justify-content-between">
                            <h5 class="modal-title" id="reportPostLabel">Report Post</h5>
                            <button type="button" class="close text-primary-emphasis" data-bs-dismiss="modal" aria-label="Close" style="font-size: 2rem;">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form id="ReportPostForm" method="post" enctype="multipart/form-data">
                                <div class="row mb-2">
                                    <p>
                                        Please let us know why you’re reporting this post. Your feedback helps us review issues more accurately and keep the community safe.
                                    </p>
                                </div>
                                <div class="row mb-2">
                                    <select class="form-select" aria-label="Default select example" name="ReasonForReport">
                                        <option value="Illegal Activities">Illegal Activities</option>
                                        <option value="Child Exploitation">Child Exploitation</option>
                                        <option value="Violence or Threats">Violence or Threats</option>
                                        <option value="Spam or Scams">Spam or Scams</option>
                                        <option value="Fraud or Deceptive Behavior">Fraud or Deceptive Behavior</option>
                                        <option value="Other (Please Specify)">Other (Please Specify)</option>
                                    </select>
                                </div>
                                <div class="row mb-2">
                                    <div id="ReportPostTextboxContainer" class="p-0">
                                        <textarea id="ReportPostTextbox" name="ExtraInformation"></textarea>
                                    </div>
                                </div>
                                <input type="hidden" name="PostId" id="PostId"/>
                                <div class="row mb-2">
                                    <button id="ReportPostButton" class="btn btn-dark rounded-2 interactable" value="Create" type="Submit">Report Post</button>
                                </div>
                                <div class="row p-0">
                                    <span id="ReportPostValidationMessage" hidden class="text-primary" aria-live="polite"></span>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col"></div>
    </div>
}