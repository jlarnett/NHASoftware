@using Microsoft.AspNetCore.Identity
@using NHA.Website.Software.Entities.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


@{
    var returnUrl = HtmlEncoder.Encode(ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString);
}

<ul class="navbar-nav flex-column flex-sm-row ms-sm-auto align-items-stretch align-items-sm-center gap-2 py-2 py-sm-0 site-auth-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item align-self-center me-2 order-2 order-sm-1 position-relative site-search-shell">
            <label class="visually-hidden" for="searchInput">Search Anime Social</label>
            <input type="text" class="form-control align-self-center interactable w-100 w-sm-auto px-3" id="searchInput" placeholder="Search Anime Social" />

            <!-- Dropdown container -->
            <ul id="searchDropdown" class="bg-body-tertiary site-search-dropdown list-unstyled shadow-lg rounded-4">
            </ul>
        </li>
        var user = await UserManager.GetUserAsync(User);

        @if(user != null)
        {
            string profilePicture = "~/ProfilePictures/" + user.ProfilePicturePath;

            <li class="nav-item dropdown align-content-center order-1 order-sm-2 site-auth-item site-profile-item">

                <!-- Profile Picture Dropdown Toggle -->
                <a class="nav-link dropdown-toggle p-1 pe-sm-2 interactable text-center site-profile-toggle" href="#" id="profileDropdown" role="button"
                   data-bs-toggle="dropdown" aria-expanded="false">
                    <img id="ProfilePicture"
                         src="@Url.Content(profilePicture)"
                         alt="Current User's Profile Picture"
                          class="rounded-circle login-profile-picture shadow-sm" />
                </a>

                <!-- Dropdown Menu -->
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end text-start shadow-lg border-0 rounded-4 p-2" aria-labelledby="profileDropdown">
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2 rounded-3" asp-controller="Users" asp-action="GetProfiles" asp-route-userId="@user.Id">
                            <i class="bi bi-person-circle"></i>
                            <span>Profile</span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2 rounded-3" asp-area="Identity" asp-page="/Account/Manage/Index">
                            <i class="bi bi-gear"></i>
                            <span>Manage</span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2 rounded-3" asp-controller="Users" asp-action="Logout" asp-route-returnUrl="@returnUrl">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </a>
                    </li>
                </ul>
            </li>
        }


    }
    else
    {
        <li class="nav-item align-self-center me-2 order-3 order-sm-1 position-relative site-search-shell">
            <label class="visually-hidden" for="searchInput">Search Anime Social</label>
            <input type="text" id="searchInput" class="form-control interactable d-block px-3" placeholder="Search Anime Social" />
            <!-- Dropdown container -->
            <ul id="searchDropdown" class="bg-body-tertiary site-search-dropdown list-unstyled shadow-lg rounded-4">
            </ul>
        </li>
        <li class="nav-item align-self-center interactable order-1 order-sm-2 site-auth-item">
            <a class="nav-link btn-dark text-light rounded-2 h5 m-0 d-block text-center text-nowrap main-nav-link" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus"></i>
                Register
            </a>
        </li>
        <li class="nav-item align-self-center interactable order-2 order-sm-3 site-auth-item">
            <a class="nav-link btn-dark text-light rounded-2 h5 m-0 d-block text-center text-nowrap main-nav-link" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right"></i>
                Login
            </a>
        </li>
    }
</ul>
<script src="~/Scripts/Shared/searchbar.js"></script>

