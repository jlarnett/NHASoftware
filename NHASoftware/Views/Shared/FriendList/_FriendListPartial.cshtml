@using Microsoft.AspNetCore.Identity
@using NHA.Website.Software.Entities.Identity
@using NHA.Website.Software.FeatureManagement
@using NHA.Website.Software.Services.FriendSystem
@using NHA.Website.Software.Services.SessionHistory
@using NHA.Website.Software.Services.Time
@using NHA.Website.Software.Services.RepositoryPatternFoundationals
@using NHA.Website.Software.Services.Sponsors
@using NHA.Website.Software.Views.Shared.Sponsers.ViewModel

@inject IFriendSystem _FriendSystem
@inject SignInManager<ApplicationUser> _SignInManager
@inject UserManager<ApplicationUser> _UserManager
@inject IActiveSessionTracker _SessionTracker
@inject ITimeBender _TimeBender
@inject IUnitOfWork _UnitOfWork
@inject IAdMaximizerService AdMaximizerService

@{
    var randomGame = await _UnitOfWork.GamePageRepository.GetRandomEntityAsync();
}

@{
    var topTenGames = await _UnitOfWork.GamePageRepository.GetAllAsync();
    topTenGames = topTenGames.OrderByDescending(g => g.GameScore).Take(10).ToList();
}

@{
    var featuredGame = (await _UnitOfWork.GamePageRepository.FindAsync(a => a.Featured)).FirstOrDefault();

    if (_SignInManager.IsSignedIn(User))
    {
        <div id="FriendListUI" class="col position-fixed w-inherit" style="height: 100%; overflow-y: auto; overflow-x: hidden; direction: rtl;">
            <div style="direction: ltr; padding: 0 .65rem 1rem .85rem;">
                <div class="row">
                    <div class="mb-3 pb-2 border-bottom border-1 border-light-subtle">
                        <span class="text-uppercase small fw-bold tracking-wider text-primary">Friends List</span>
                    </div>
                </div>
                @Html.AntiForgeryToken()
                @{
                    var friends = await _FriendSystem.GetUsersFriendListAsync(_UserManager.GetUserId(User)!);
                    Dictionary<ApplicationUser, string> onlineUsers = new Dictionary<ApplicationUser, string>();
                    Dictionary<ApplicationUser, string> offlineUsers = new Dictionary<ApplicationUser, string>();


                foreach (var friend in friends)
                {
                    var lastSessionActivityDate = await _SessionTracker.GetUserLastActiveTime(friend);

                    if (lastSessionActivityDate.HasValue)
                    {
                        var minutesSinceLastActivity = (int)(DateTime.UtcNow - lastSessionActivityDate.Value).TotalMinutes;

                        if(minutesSinceLastActivity < 10)
                            onlineUsers.Add(friend, _TimeBender.GetTimeShortHandString(lastSessionActivityDate.Value));
                        else
                            offlineUsers.Add(friend, _TimeBender.GetTimeShortHandString(lastSessionActivityDate.Value));
                    }
                    else
                    {
                        offlineUsers.Add(friend, "offline");
                    }
                }

                <details class="m-auto mb-3 w-100 rounded-3 border border-success border-opacity-25 bg-dark bg-opacity-25 p-2 shadow-sm" open>
                    <summary class="d-flex align-items-center justify-content-between px-2 py-1 text-light" style="cursor: pointer; list-style: none;">
                        <span class="d-flex align-items-center gap-2 fw-semibold">
                            <span class="rounded-circle bg-success d-inline-block" style="width: 10px; height: 10px;"></span>
                            <span>Online Friends</span>
                        </span>
                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis">@onlineUsers.Count</span>
                    </summary>
                    @{
                        foreach (var friend in onlineUsers)
                        {
                            Random random = new Random();
                            int friendButtonIdNumber = random.Next();
                            var newMessages = await _UnitOfWork.ChatMessageRepository.GetNewMessageBetweenUsersAsync(friend.Key.Id, _UserManager.GetUserId(User)!);


                            <div class="m-auto mb-2 w-100 rounded-4 border border-success border-opacity-25 bg-black bg-opacity-25 p-1 shadow-sm dropdown no-hover">
                                <button id="friend-dropdown-@friendButtonIdNumber" class="col btn btn-dark border-0 bg-transparent rounded-4 p-0 overflow-hidden" data-bs-toggle="dropdown" aria-expanded="false" friend-id="@friend.Key.Id ">
                                    <div class="d-flex align-items-center flex-nowrap bg-transparent m-auto px-2 py-2 text-decoration-none fl-click" friend-id="@friend.Key.Id" role="button">
                                        <div class="flex-shrink-0 position-relative me-2" friend-id="@friend.Key.Id">
                                            <img src="~/ProfilePictures/@friend.Key.ProfilePicturePath" friend-id="@friend.Key.Id" class="img-fluid rounded-circle bg-primary border border-2 border-success-subtle" style="width: 46px; height: 46px; object-fit: cover;" />
                                            <span class="position-absolute bottom-0 end-0 rounded-circle bg-success border border-dark" style="width: 12px; height: 12px;" friend-id="@friend.Key.Id"></span>
                                        </div>
                                        <div class="flex-grow-1 min-w-0 text-start" friend-id="@friend.Key.Id">
                                            <div class="fw-semibold text-truncate" friend-id="@friend.Key.Id">@friend.Key.DisplayName</div>
                                            <div class="small text-white-50 text-truncate" friend-id="@friend.Key.Id">Active @friend.Value</div>
                                        </div>
                                        <div class="flex-shrink-0 d-flex align-items-center gap-2 ms-2" friend-id="@friend.Key.Id">
                                            @if (newMessages.Count > 0)
                                            {
                                                <span class="badge rounded-pill bg-danger" friend-id="@friend.Key.Id">@newMessages.Count</span>
                                            }
                                            <div class="px-2 py-1 bg-success-subtle text-success-emphasis rounded-pill small fw-semibold" friend-id="@friend.Key.Id">Online</div>
                                        </div>
                                    </div>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark shadow no-hover" aria-labelledby="friend-dropdown-@friendButtonIdNumber" style="z-index: 1002342442;">
                                    <li>
                                        <button id="OpenChat" class="dropdown-item open-chat d-flex align-items-center justify-content-between" type="button" friend-id="@friend.Key.Id">
                                            <div class="row w-100 align-items-center" friend-id="@friend.Key.Id">
                                                <div class="col d-flex align-items-center gap-2" friend-id="@friend.Key.Id">
                                                    <i class="bi bi-chat-dots-fill" friend-id="@friend.Key.Id"></i>
                                                    <span friend-id="@friend.Key.Id">Chat</span>
                                                </div>

                                                @if (newMessages.Count > 0)
                                                {
                                                    <div id="Friend-chat-notification-counter-@friend.Key.Id" class="bg-danger rounded-circle col-auto m-auto px-2 py-1" friend-id="@friend.Key.Id">
                                                        <div class="text-center m-auto text-white small fw-bold" friend-id="@friend.Key.Id">@newMessages.Count</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div id="Friend-chat-notification-counter-@friend.Key.Id" class="bg-danger rounded-circle col-auto m-auto px-2 py-1" friend-id="@friend.Key.Id" style="display: none;">
                                                        <div class="text-center m-auto text-white small fw-bold" friend-id="@friend.Key.Id">@newMessages.Count</div>
                                                    </div>
                                                }
                                            </div>
                                        </button>
                                    </li>
                                    <li><a class="dropdown-item d-flex align-items-center gap-2" type="button" asp-controller="Users" asp-action="GetProfiles" asp-route-userId="@friend.Key.Id"><i class="bi bi-person-badge"></i><span>Profile</span></a></li>
                                </ul>
                            </div>
                        }
                    }
                </details>
                <details class="m-auto mb-2 pb-4 w-100 rounded-3 border border-light border-opacity-10 bg-dark bg-opacity-25 p-2 shadow-sm" open>
                    <summary class="d-flex align-items-center justify-content-between px-2 py-1 text-light" style="cursor: pointer; list-style: none;">
                        <span class="d-flex align-items-center gap-2 fw-semibold">
                            <span class="rounded-circle bg-secondary d-inline-block" style="width: 10px; height: 10px;"></span>
                            <span>Offline Friends</span>
                        </span>
                        <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">@offlineUsers.Count</span>
                    </summary>
                    @{
                        foreach (var friend in offlineUsers)
                        {
                            Random random = new Random();
                            int friendButtonIdNumber = random.Next();
                            var newMessages = await _UnitOfWork.ChatMessageRepository.GetNewMessageBetweenUsersAsync(friend.Key.Id, _UserManager.GetUserId(User)!);


                            <div class="m-auto mb-2 w-100 rounded-4 border border-light border-opacity-10 bg-black bg-opacity-25 p-1 shadow-sm dropdown no-hover">
                                <button id="friend-dropdown-@friendButtonIdNumber" class="col btn btn-dark border-0 bg-transparent rounded-4 p-0 overflow-hidden" data-bs-toggle="dropdown" aria-expanded="false" friend-id="@friend.Key.Id ">
                                    <div class="d-flex align-items-center flex-nowrap bg-transparent m-auto px-2 py-2 text-decoration-none fl-click" friend-id="@friend.Key.Id" role="button">
                                        <div class="flex-shrink-0 position-relative me-2" friend-id="@friend.Key.Id">
                                            <img src="~/ProfilePictures/@friend.Key.ProfilePicturePath" friend-id="@friend.Key.Id" class="img-fluid rounded-circle bg-primary border border-2 border-secondary-subtle" style="width: 46px; height: 46px; object-fit: cover;" />
                                            <span class="position-absolute bottom-0 end-0 rounded-circle bg-secondary border border-dark" style="width: 12px; height: 12px;" friend-id="@friend.Key.Id"></span>
                                        </div>
                                        <div class="flex-grow-1 min-w-0 text-start" friend-id="@friend.Key.Id">
                                            <div class="fw-semibold text-truncate" friend-id="@friend.Key.Id">@friend.Key.DisplayName</div>
                                            <div class="small text-white-50 text-truncate" friend-id="@friend.Key.Id">Last seen @friend.Value</div>
                                        </div>
                                        <div class="flex-shrink-0 d-flex align-items-center gap-2 ms-2" friend-id="@friend.Key.Id">
                                            @if (newMessages.Count > 0)
                                            {
                                                <span class="badge rounded-pill bg-danger" friend-id="@friend.Key.Id">@newMessages.Count</span>
                                            }
                                            <div class="px-2 py-1 bg-secondary-subtle text-secondary-emphasis rounded-pill small fw-semibold" friend-id="@friend.Key.Id">Offline</div>
                                        </div>
                                    </div>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark shadow no-hover" aria-labelledby="friend-dropdown-@friendButtonIdNumber" style="z-index: 1002342442;">
                                    <li>
                                        <button id="OpenChat" class="dropdown-item open-chat d-flex align-items-center justify-content-between" type="button" friend-id="@friend.Key.Id">
                                            <div class="row w-100 align-items-center" friend-id="@friend.Key.Id">
                                                <div class="col d-flex align-items-center gap-2" friend-id="@friend.Key.Id">
                                                    <i class="bi bi-chat-dots-fill" friend-id="@friend.Key.Id"></i>
                                                    <span friend-id="@friend.Key.Id">Chat</span>
                                                </div>
                                                
                                                @if (newMessages.Count > 0)
                                                {
                                                    <div id="Friend-chat-notification-counter-@friend.Key.Id" class="bg-danger rounded-circle col-auto m-auto px-2 py-1" friend-id="@friend.Key.Id">
                                                        <div class="text-center m-auto text-white small fw-bold" friend-id="@friend.Key.Id">@newMessages.Count</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div id="Friend-chat-notification-counter-@friend.Key.Id" class="bg-danger rounded-circle col-auto m-auto px-2 py-1" friend-id="@friend.Key.Id" style="display: none;">
                                                        <div class="text-center m-auto text-white small fw-bold" friend-id="@friend.Key.Id">@newMessages.Count</div>
                                                    </div>
                                                }

                                            </div>
                                        </button>
                                    </li>
                                    <li><a class="dropdown-item d-flex align-items-center gap-2" type="button" asp-controller="Users"  asp-action="GetProfiles" asp-route-userId="@friend.Key.Id"><i class="bi bi-person-badge"></i><span>Profile</span></a></li>
                                </ul>
                            </div>
                        }
                    }
                </details>
                }
            
                @if (featuredGame is not null)
                {
                    <div class="row">
                        <div class="mb-3 pb-2 border-bottom border-1 border-light-subtle">
                            <span class="text-uppercase small fw-bold tracking-wider text-primary">Editor's Choice</span>
                        </div>
                    </div>
        
                    <div class="row m-auto pt-1 pb-1 text-center">
                        <a asp-action="GamePage" class="h5 text-body text-decoration-none interactable fw-semibold" asp-controller="Game" asp-route-id="@featuredGame.Id">@featuredGame.Name</a>
                        <div class="">
                            <a class="row text-center m-auto rounded-2 interactable" asp-controller="Game" asp-action="GamePage" asp-route-id="@featuredGame.Id">
                                <img src="@featuredGame.ImageUrl" title="@featuredGame.Name" class="rounded-3 p-0" alt="@featuredGame.Name's cover photo" />
                            </a>
                        </div>
                        <div class="multiline-ellipsis expandable-ellipsis interactable-small"
                             style="max-width: 350px;"
                             role="button"
                             tabindex="0"
                             aria-expanded="false"
                             title="Click to expand or collapse">
                            @Html.Raw(@featuredGame.Summary)
                        </div> 
                        @{ await Html.RenderPartialAsync("Sponsers/_GenreListPartial", new GenreListVm(@featuredGame.Genres ?? string.Empty, GenreListType.Game)); }
                        <div><strong>Score:</strong> @featuredGame.GameScore/5</div>
                    </div>
                }

                <a class="btn btn-outline-primary w-100 mb-2"
                   asp-area="" asp-controller="Game" asp-action="Index" asp-route-pageNumber="1">
                    <i class="bi bi-card-text"></i> Wiki
                </a>

                <a class="btn btn-outline-primary w-100 mb-2"
                   asp-area="" asp-controller="Game" asp-action="GamePage" asp-route-id="@randomGame!.Id">
                    <i class="bi bi-shuffle"></i> Random
                </a>
            
                <a class="btn btn-outline-primary w-100 mb-2"
                   asp-area="" asp-controller="Game" asp-action="Rankings">
                    <i class="bi bi-bar-chart"></i> Rankings
                </a>

                <div class="row">
                    <div class="mb-3 pb-2 border-bottom border-1 border-light-subtle">
                        <span class="text-uppercase small fw-bold tracking-wider text-primary">Top 10</span>
                    </div>
                </div>

                @if (topTenGames.Any())
                {
                    <ol class="list-group list-group-numbered d-flex flex-column gap-2 mb-4 w-100">
                        @foreach (var game in topTenGames)
                        {
                            <li class="list-group-item bg-body-secondary rounded-3 px-3 py-2 border border-secondary-subtle shadow-sm position-relative interactable-small">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="d-flex align-items-start gap-2 me-2">
                                        <img src="@game.ImageUrl"
                                             class="rounded-2 flex-shrink-0"
                                             style="width: 42px; height: 56px; object-fit: cover;"
                                             alt="@game.Name's cover photo" />
                                        <div>
                                            <a class="text-body text-decoration-none fw-semibold stretched-link"
                                               asp-controller="Game"
                                               asp-action="GamePage"
                                               asp-route-id="@game.Id">
                                                @game.Name
                                            </a>
                                        </div>
                                    </div>
                                    <span class="badge text-bg-primary rounded-pill position-relative">@game.GameScore/5</span>
                                </div>
                            </li>
                        }
                    </ol>
                }

                <div class="row">
                    <div class="mb-3 pb-2 border-bottom border-1 border-light-subtle">
                        <span class="text-uppercase small fw-bold tracking-wider text-primary">Partnerships</span>
                    </div>
                </div>

                @{
                    var ads = await AdMaximizerService.GetBestAdsForUserAsync();

                    foreach (var ad in ads)
                    {

                        if (ad.VideoUrl != null)
                        {
                            <feature name="@FeatureFlags.SponsorAdsEnabled">
                                <div class="row m-auto pt-1 pb-1 text-center">
                                    <div class="col">
                                        <div class="ratio ratio-16x9 rounded-2 overflow-hidden">
                                            <iframe src="@ad.VideoUrl"
                                                    title="YouTube video"
                                                    allowfullscreen
                                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
                                            </iframe>
                                        </div>
                                    </div>
                                </div>
                            </feature>
                        }

                        if (ad.ImageUrl != null)
                        {
                            <div class="row m-auto pt-1 pb-1 text-center">
                                <iframe src=@ad.ImageUrl
                                        title="Sponsor Video"
                                        height="350px"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                        allowfullscreen>
                                </iframe>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }
    else
    {
        <div class="col position-fixed w-inherit" style="height: 100%; overflow-y: auto; overflow-x: hidden; direction: rtl;">
            <div style="direction: ltr; padding: 0 .65rem 1rem .85rem;">
                @if (featuredGame is not null)
                {
                    <div class="row">
                        <div class="mb-3 pb-2 border-bottom border-1 border-light-subtle">
                            <span class="text-uppercase small fw-bold tracking-wider text-primary">Editor's Choice</span>
                        </div>
                    </div>
        
                    <div class="row m-auto pt-1 pb-1 text-center">
                        <a asp-action="GamePage" class="h5 text-body text-decoration-none interactable fw-semibold" asp-controller="Game" asp-route-id="@featuredGame.Id">@featuredGame.Name</a>
                        <div class="">
                            <a class="row text-center m-auto rounded-2 interactable" asp-controller="Game" asp-action="GamePage" asp-route-id="@featuredGame.Id">
                                <img src="@featuredGame.ImageUrl" title="@featuredGame.Name" class="rounded-3 p-0" alt="@featuredGame.Name's cover photo" />
                            </a>
                        </div>
                        <div class="multiline-ellipsis expandable-ellipsis interactable-small"
                             style="max-width: 350px;"
                             role="button"
                             tabindex="0"
                             aria-expanded="false"
                             title="Click to expand or collapse">
                            @Html.Raw(@featuredGame.Summary)
                        </div>
                        @{ await Html.RenderPartialAsync("Sponsers/_GenreListPartial", new GenreListVm(@featuredGame.Genres ?? string.Empty, GenreListType.Game)); }
                        <div><strong>Score:</strong> @featuredGame.GameScore/5</div>
                    </div>
                }
            
                <a class="btn btn-outline-primary w-100 mb-2"
                   asp-area="" asp-controller="Game" asp-action="Index" asp-route-pageNumber="1">
                    <i class="bi bi-card-text"></i> Wiki
                </a>

                <a class="btn btn-outline-primary w-100 mb-2"
                   asp-area="" asp-controller="Game" asp-action="GamePage" asp-route-id="@randomGame!.Id">
                    <i class="bi bi-shuffle"></i> Random
                </a>
                <a class="btn btn-outline-primary w-100 mb-2"
                   asp-area="" asp-controller="Game" asp-action="Rankings">
                    <i class="bi bi-bar-chart"></i> Rankings
                </a>

                <div class="row">
                    <div class="mb-3 pb-2 border-bottom border-1 border-light-subtle">
                        <span class="text-uppercase small fw-bold tracking-wider text-primary">Top 10</span>
                    </div>
                </div>

                @if (topTenGames.Any())
                {
                    <ol class="list-group list-group-numbered d-flex flex-column gap-2 mb-4 w-100">
                        @foreach (var game in topTenGames)
                        {
                            <li class="list-group-item bg-body-secondary interactable-small rounded-3 px-3 py-2 border border-secondary-subtle shadow-sm position-relative">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="d-flex align-items-start gap-2 me-2">
                                        <img src="@game.ImageUrl"
                                             class="rounded-2 flex-shrink-0"
                                             style="width: 42px; height: 56px; object-fit: cover;"
                                             alt="@game.Name's cover photo" />
                                        <div>
                                            <a class="text-body text-decoration-none fw-semibold stretched-link"
                                               asp-controller="Game"
                                               asp-action="GamePage"
                                               asp-route-id="@game.Id">
                                                @game.Name
                                            </a>
                                        </div>
                                    </div>
                                    <span class="badge text-bg-primary rounded-pill position-relative">@game.GameScore/5</span>
                                </div>
                            </li>
                        }
                    </ol>
                }
            
                <div class="row">
                    <div class="mb-3 pb-2 border-bottom border-1 border-light-subtle">
                        <span class="text-uppercase small fw-bold tracking-wider text-primary">Partnerships</span>
                    </div>
                </div>
            
                @{
                    var ads = await AdMaximizerService.GetBestAdsForUserAsync();

                    foreach (var ad in ads)
                    {

                        if (ad.VideoUrl != null)
                        {
                            <feature name="@FeatureFlags.SponsorAdsEnabled">
                                <div class="row m-auto pt-1 pb-1 text-center">
                                    <div class="col">
                                        <div class="ratio ratio-16x9 rounded-2 overflow-hidden">
                                            <iframe src="@ad.VideoUrl"
                                                    title="YouTube video"
                                                    allowfullscreen
                                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
                                            </iframe>
                                        </div>
                                    </div>
                                </div>
                            </feature>
                        }

                        if (ad.ImageUrl != null)
                        {
                            <div class="row m-auto pt-1 pb-1 text-center">
                                <iframe src=@ad.ImageUrl
                                        title="Sponsor Video"
                                        height="350px"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                        allowfullscreen>
                                </iframe>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }
}