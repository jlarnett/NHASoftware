        background: rgba(var(--bs-tertiary-bg-rgb), 0.82);
        backdrop-filter: blur(12px);
    }

    .anime-rankings-page .rankings-hero {
        background:
            radial-gradient(circle at top left, rgba(220, 53, 69, 0.22), transparent 35%),
            radial-gradient(circle at bottom right, rgba(13, 110, 253, 0.16), transparent 35%),
            rgba(var(--bs-tertiary-bg-rgb), 0.9);
        border-radius: 1.5rem;
    }

    .anime-rankings-page .rankings-surface,
    .anime-rankings-page .podium-card,
    .anime-rankings-page .ranking-card,
    .anime-rankings-page .leader-spotlight,
    .anime-rankings-page .ranking-stat-tile {
        border-radius: 1.25rem;
        box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.08);
    }

    .anime-rankings-page .leader-spotlight,
    .anime-rankings-page .ranking-stat-tile {
        background: rgba(var(--bs-body-bg-rgb), 0.56);
        border: 1px solid rgba(var(--bs-emphasis-color-rgb), 0.08);
    }

    body[data-bs-theme="dark"] .anime-rankings-page .leader-spotlight,
    body[data-bs-theme="dark"] .anime-rankings-page .ranking-stat-tile,
    body[data-bs-theme="dark"] .anime-rankings-page .podium-card,
    body[data-bs-theme="dark"] .anime-rankings-page .ranking-card {
        box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.28);
    }

    .anime-rankings-page .ranking-stat-tile {
        min-width: 10rem;
        padding: 1rem 1.1rem;
    }

    .anime-rankings-page .quick-filter-group .btn.active,
    .anime-rankings-page .view-toggle-group .btn.active {
        color: var(--bs-white);
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
    }

    .anime-rankings-page .podium-card,
    .anime-rankings-page .ranking-card {
        padding: 1rem;
        height: 100%;
    }

    .anime-rankings-page .podium-poster,
    .anime-rankings-page .ranking-card__media {
        position: relative;
        overflow: hidden;
        border-radius: 1rem;
        aspect-ratio: 3 / 4;
        background:
            linear-gradient(145deg, rgba(220, 53, 69, 0.18), rgba(13, 110, 253, 0.14)),
            rgba(var(--bs-secondary-bg-rgb), 0.96);
    }

    .anime-rankings-page .podium-poster img,
    .anime-rankings-page .ranking-card__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .anime-rankings-page .podium-poster-placeholder,
    .anime-rankings-page .ranking-poster-placeholder {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: var(--bs-secondary-color);
    }

    .anime-rankings-page .rank-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 3.25rem;
        padding: 0.45rem 0.75rem;
        border-radius: 999px;
