@using System.Text.RegularExpressions
@using System.Text.Json
@using NHA.Website.Software.Entities.Game
@using NHA.Website.Software.Services.RepositoryPatternFoundationals
@inject IUnitOfWork UnitOfWork

@{
    ViewData["Title"] = "Game Rankings";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var games = (await UnitOfWork.GamePageRepository.FindWithoutTrackingAsync(static gamePage => true)).ToList();
    static IEnumerable<string> ParseSegments(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? Enumerable.Empty<string>()
            : value.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(segment => !string.IsNullOrWhiteSpace(segment));
    }

    static string StripHtml(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var cleaned = Regex.Replace(value, "<.*?>", " ");
        return Regex.Replace(cleaned, @"\s+", " ").Trim();
    }

    static string Truncate(string value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length <= maxLength)
        {
            return value;
        }

        return value[..maxLength].TrimEnd() + "…";
    }

    static int NetVotes(GamePage gamePage) => gamePage.UpVotes - gamePage.DownVotes;

    static double SafeScore(GamePage gamePage) => gamePage.GameScore is > 0 ? gamePage.GameScore.Value : 0;

    static double HybridScore(GamePage gamePage)
    {
        var scoreBoost = SafeScore(gamePage) * 10;
        var communityBoost = NetVotes(gamePage) * 2;
        var featuredBoost = gamePage.Featured ? 12 : 0;
        var releasedBoost = gamePage.Status?.Contains("released", StringComparison.OrdinalIgnoreCase) == true ? 6 : 0;

        return scoreBoost + communityBoost + featuredBoost + releasedBoost;
    }

    string StatusTone(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "bg-secondary-subtle text-secondary-emphasis";
        }

        if (status.Contains("released", StringComparison.OrdinalIgnoreCase) || status.Contains("available", StringComparison.OrdinalIgnoreCase))
        {
            return "bg-success-subtle text-success-emphasis";
        }

        if (status.Contains("early access", StringComparison.OrdinalIgnoreCase) || status.Contains("beta", StringComparison.OrdinalIgnoreCase))
        {
            return "bg-primary-subtle text-primary-emphasis";
        }

        if (status.Contains("upcoming", StringComparison.OrdinalIgnoreCase) || status.Contains("not yet", StringComparison.OrdinalIgnoreCase))
        {
            return "bg-warning-subtle text-warning-emphasis";
        }

        return "bg-secondary-subtle text-secondary-emphasis";
    }

    string BuildSearchData(GamePage gamePage)
    {
        var searchParts = new[]
        {
            gamePage.Name,
            StripHtml(gamePage.Summary),
            gamePage.Genres,
            gamePage.Platforms,
            gamePage.Status,
            gamePage.Released
        };

        return string.Join(" ", searchParts.Where(text => !string.IsNullOrWhiteSpace(text))).ToLowerInvariant();
    }

    var rankedGames = games
        .OrderByDescending(gamePage => HybridScore(gamePage))
        .ThenByDescending(gamePage => SafeScore(gamePage))
        .ThenByDescending(gamePage => NetVotes(gamePage))
        .ThenBy(gamePage => gamePage.Name)
        .ToList();

    var topThree = rankedGames.Take(3).ToList();

    var allGenres = games
        .SelectMany(gamePage => ParseSegments(gamePage.Genres))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value)
        .ToList();

    var allStatuses = games
        .Select(gamePage => gamePage.Status?.Trim())
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value)
        .ToList();

    var hiddenGemCount = games.Count(gamePage => SafeScore(gamePage) >= 7.5 && NetVotes(gamePage) <= 5);
    const int initialRenderCount = 48;
    var rankingDetailBaseUrl = Url.Action("GamePage", "Game") ?? "/Game/GamePage";
    var rankingClientItems = rankedGames
        .Select(gamePage =>
        {
            var previewText = Truncate(StripHtml(gamePage.Summary), 180);
            var statusLabel = string.IsNullOrWhiteSpace(gamePage.Status) ? "Status unknown" : gamePage.Status!;
            var releasedLabel = string.IsNullOrWhiteSpace(gamePage.Released) ? "Release date unknown" : gamePage.Released!;

            return new
            {
                id = gamePage.Id,
                title = gamePage.Name,
                search = BuildSearchData(gamePage),
                status = statusLabel.ToLowerInvariant(),
                statusLabel,
                genres = ParseSegments(gamePage.Genres).Take(3).ToArray(),
                genreTokens = ParseSegments(gamePage.Genres).Select(segment => segment.ToLowerInvariant()).ToArray(),
                featured = gamePage.Featured,
                imageUrl = gamePage.ImageUrl,
                score = SafeScore(gamePage),
                upvotes = gamePage.UpVotes,
                downvotes = gamePage.DownVotes,
                net = NetVotes(gamePage),
                hybrid = HybridScore(gamePage),
                released = releasedLabel,
                platformPreview = string.Join(", ", ParseSegments(gamePage.Platforms).Take(2)),
                previewText = string.IsNullOrWhiteSpace(previewText)
                    ? "No game summary has been added yet, so let the rankings guide the vibe check."
                    : previewText
            };
        })
        .ToList();
    var rankingClientJson = JsonSerializer.Serialize(rankingClientItems);
}

<style>
    .anime-rankings-page .rankings-hero,
    .anime-rankings-page .rankings-surface,
    .anime-rankings-page .podium-card,
    .anime-rankings-page .ranking-card {
