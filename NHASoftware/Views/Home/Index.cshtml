@using Microsoft.AspNetCore.Identity
@using NHA.Website.Software.Entities.Identity
@using NHA.Website.Software.FeatureManagement
@using NHA.Website.Software.Services.SessionHistory
@using NHA.Website.Software.Services.Social.PostBuilderService
@using NHA.Website.Software.Views.Shared.Social.ViewModels



@inject UserManager<ApplicationUser> _UserManager
@inject SignInManager<ApplicationUser> _SignInManager
@inject IPostBuilder _PostBuilder
@inject IActiveSessionTracker _SessionTracker

@{
    ViewData["Title"] = "Feed";
    const int homeFeedPageSize = 25;
}
<head>
    <link rel="stylesheet" href="~/css/MainPostFeed.css">
</head>


<div class="container-fluid">
    <div class="row">
        <div class="HomeContainer col-12 col-sm-9 col-lg-9">
            @if (_SignInManager.IsSignedIn(User))
            {
                @Html.AntiForgeryToken()
                <div class="home-post-composer mb-4" style="opacity: 0.97;">
                    <div class="row g-0 border home-post-form-row rounded-4 shadow-sm overflow-hidden">
                        <div class="col-12 px-3 pt-3 pb-2 border-bottom border-light-subtle bg-body-tertiary">
                            <div class="d-flex align-items-center gap-2 small text-uppercase fw-semibold text-primary-emphasis">
                                <i class="bi bi-stars"></i>
                                <span>Share an update</span>
                            </div>
                        </div>
                        <div class="col-12 px-0">
                            <form id="BasicPostForm" method="post" enctype="multipart/form-data" class="w-100">
                                <div id="MainPostTextboxContainer" class="w-100 p-0">
                                    @* <textarea id="MainPostTextbox" name="Summary"></textarea> *@
                                    <input asp-for="Summary" id="MainPostTextbox"/>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="row py-1 g-2 mx-0">
                        <div class="col px-0">
                            <button id="SubmitBtn"
                                    user="@_UserManager.GetUserId(User)"
                                    type="button"
                                    class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2 fs-5 interactable">
                                    <i class="bi bi-send-fill"></i>
                                <span class="btn-text">Upload</span>
                                <div id="BasicPostLoadingSpinner"
                                     class="spinner-border spinner-border-sm text-light d-none"
                                     role="status"
                                     aria-hidden="true"></div>
                            </button>
                        </div>

                        <feature name="@FeatureFlags.CustomizedPostsEnabled">
                            <div class="col px-0">
                                <button id="AddPhotos"
                                        user="@_UserManager.GetUserId(User)"
                                        type="button"
                                        class="btn btn-info w-100 d-flex align-items-center justify-content-center gap-2 fs-5 interactable"
                                        data-bs-toggle="modal"
                                        data-bs-target="#AddPostPhotosModal">
                                    <i class="bi bi-images"></i>
                                    <span>Upload With Media</span>
                                </button>
                            </div>
                        </feature>
                    </div>
                    <div class="row mx-0">
                        <div class="col-12 px-0">
                            <span id="MainPostTextboxValidationMessage" class="text-primary small mt-2 align-items-center gap-1" hidden aria-live="polite"></span>
                        </div>
                    </div>
                </div>
            }

            <div id="HomeContentFeed" class="w-100" user-session-active="@_SignInManager.IsSignedIn(User).ToString()" userId="@_UserManager.GetUserId(User)">
                <div id="ContentFeed" class="" data-current-page="1" data-page-size="@homeFeedPageSize" data-has-more="true">
                    @{
                        var posts = await _PostBuilder.RetrieveParentPosts(_UserManager.GetUserId(User) ?? "", 1, homeFeedPageSize);
                        var lastActiveTimes = await _SessionTracker.GetUsersLastActiveTimesAsync(posts
                            .Select(post => post.UserId)
                            .Where(userId => !string.IsNullOrWhiteSpace(userId))
                            .Cast<string>());

                        foreach (var post in posts)
                        {
                            if (!string.IsNullOrWhiteSpace(post.UserId) && lastActiveTimes.TryGetValue(post.UserId, out var lastActiveTime))
                            {
                                post.UserLastActiveTime = lastActiveTime;
                            }
                        }

                        await Html.RenderPartialAsync("Social/_MultiPost", new MultiPostVM(posts));
                    }
                </div>
            </div>
        </div>
    </div>

</div>

@if (_SignInManager.IsSignedIn(User))
{
    <feature name="@FeatureFlags.CustomizedPostsEnabled">
        <div class="modal fade" id="AddPostPhotosModal" tabindex="-1" role="dialog" aria-labelledby="AddPostPhotosModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="modal-header border-bottom justify-content-between">
                        <h5 class="modal-title text-primary" id="AddPostPhotosModalLabel">Personalize Post</h5>
                        <button type="button" class="btn-close interactable" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @model NHA.Website.Software.ConsumableEntities.DTOs.PostDTO
                        <form id="CustomPostForm" method="post" enctype="multipart/form-data">
                            <div class="row mb-2">
                                <div class="col-12 px-0" id="CustomPostTextboxContainer">
                                    <textarea id="CustomPostTextbox" name="Summary"></textarea>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-12 px-0">
                                    <label class="form-label fw-semibold" for="CustomPostMediaFileInput">Media</label>
                                    <input type="file" id="CustomPostMediaFileInput" class="form-control interactable" multiple="multiple" role="button" name="MediaFiles" accept="image/*,video/mp4,video/webm,video/ogg" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-12 px-0 text-start">
                                    <button id="SubmitCustomPostBtn" class="btn btn-primary rounded-3 interactable w-auto d-inline-flex align-items-center justify-content-center gap-2" value="Create" type="Submit"><i class="bi bi-upload"></i><span>Upload Custom Post</span></button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 px-0">
                                    <span id="CustomPostValidationMessage" hidden class="text-primary small" aria-live="polite"></span>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </feature>
}



@section Scripts {
    

    <script src="~/Scripts/Social_Feed/Gratitude.js" asp-append-version="true"></script>
    <script src="~/Scripts/Social_Feed/ContentFeed.Input.js" asp-append-version="true"></script>
    <script src="~/Scripts/Social_Feed/ContentFeedAjaxCalls.js" asp-append-version="true"></script>
    <script src="~/Scripts/Social_Feed/ContentFeedUtility.js" asp-append-version="true"></script>
    <script src="~/Scripts/Social_Feed/ContentFeed.js" asp-append-version="true"></script>
    <script src="~/Scripts/Social_Feed/ContentFeedImageLoader.js" asp-append-version="true"></script>
    <script src="~/Scripts/Social_Feed/ContentFeedLoader.js" asp-append-version="true"></script>
    <script>
        (() => {
            const composer = document.querySelector('.home-post-composer');
            const container = document.querySelector('.HomeContainer');

            if (!composer || !container) {
                return;
            }

            const syncComposerPosition = () => {
                if (window.innerWidth < 768) {
                    composer.style.removeProperty('left');
                    composer.style.removeProperty('width');
                    return;
                }

                const containerRect = container.getBoundingClientRect();
                composer.style.left = `${containerRect.left}px`;
                composer.style.width = `${containerRect.width}px`;
            };

            window.addEventListener('resize', syncComposerPosition);
            syncComposerPosition();
        })();

        ImageLoader.ShouldPostLoadImagesFromDB();
    </script>
}