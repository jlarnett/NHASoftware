@model NHA.Website.Software.Views.ViewModels.AdminUsersViewModel
@{
    ViewData["Title"] = "Users";
}

<div class="container mt-12 mb-5">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="mb-1">Users</h1>
            <p class="text-body-secondary mb-0">Admin-only overview of registered users and their roles.</p>
        </div>
        <a asp-action="CreateRole" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 rounded-pill">
            <i class="bi bi-shield-plus"></i>
            <span>Create Role</span>
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-3">
                <div>
                    <div class="small text-uppercase text-body-secondary fw-semibold">Total Users</div>
                    <div class="display-6 mb-0">@Model.Users.Count</div>
                </div>
                <div class="small text-body-secondary">Search, sort, and page through registered users and their roles.</div>
            </div>

            <div class="table-responsive">
                <table id="AdminUsersTable" class="table table-striped table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Display Name</th>
                            <th>User ID</th>
                            <th>Email</th>
                            <th>Roles</th>
                            <th>Joined</th>
                            <th>Profile</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            var rolesText = user.Roles.Count > 0 ? string.Join(", ", user.Roles) : "No roles";

                            <tr>
                                <td class="text-break fw-semibold">@user.DisplayName</td>
                                <td class="text-break">@user.Id</td>
                                <td class="text-break">@(string.IsNullOrWhiteSpace(user.Email) ? "N/A" : user.Email)</td>
                                <td data-order="@rolesText">
                                    @if (user.Roles.Count > 0)
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle px-3 py-2">@role</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-body-secondary text-body-emphasis border border-light-subtle px-3 py-2">No roles</span>
                                    }
                                </td>
                                <td data-order="@user.DateJoined.ToString("O")">@user.DateJoined.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <a asp-controller="Users"
                                       asp-action="GetProfiles"
                                       asp-route-userId="@user.Id"
                                       class="btn btn-sm btn-outline-primary rounded-pill d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-person-badge"></i>
                                        <span>Profile</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $("#AdminUsersTable").DataTable({
                autoWidth: false,
                responsive: true,
                pageLength: 25,
                order: [[4, "desc"]],
                language: {
                    search: "",
                    searchPlaceholder: "Search users or roles...",
                    emptyTable: "No users were found."
                },
                columnDefs: [
                    { orderable: false, targets: [5] }
                ]
            });
        });
    </script>
}
