@model NHA.Website.Software.Views.ViewModels.FriendVMs.FriendListVM
@{
    ViewData["Title"] = $"{Model.User.DisplayName}'s Friends";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var friendCount = Model.FriendsList?.Count() ?? 0;
}
<head>
    <link rel="stylesheet" href="~/css/FriendPages.css">
    <script src="~/Scripts/FriendSystem/FriendList.js"></script>
</head>


<div class="container-fluid connections-page">
    <div class="connections-card">
        <div class="row align-items-center g-3 connections-header">
            <div class="col-lg">
                <span class="connections-eyebrow">Social</span>
                <h1 class="h1 connections-title">@Model.User.DisplayName's Friend List</h1>
                <p class="connections-subtitle">Browse connections, open profiles, and manage this friend list.</p>
            </div>
            <div class="col-lg-auto">
                <div class="connections-stat-pill">
                    <span class="connections-stat-value">@friendCount</span>
                    <span class="connections-stat-label">Friends</span>
                </div>
            </div>
        </div>

        <div class="table-responsive connections-table-wrapper">
            <table id="FriendListTable" class="table align-middle mb-0 connection-table" style="width:100%" profile-user-id="@Model.User.Id">
                <thead>
                <tr>
                    <th>Friend</th>
                    <th>Actions</th>
                </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade connection-modal" id="DeleteFriendModal" tabindex="-1" aria-labelledby="DeleteFriendModalLabel" aria-hidden="true">
    @Html.AntiForgeryToken()
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DeleteFriendModalLabel">Remove Friend</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="DeleteFriendModalBodyDescription" class="modal-body">
                Are you sure you want to remove GOD from your friends list?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button id="RemoveFriendBtn" type="button" class="btn btn-danger connection-danger-button" sender-user-id="@Model.User.Id">Remove Friend</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script type="text/javascript">
        var friends = JSON.parse('@Html.Raw(Json.Serialize(Model.FriendsList))');
        LoadFriendListTable(friends);
    </script>
}
