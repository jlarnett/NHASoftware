@using System.Globalization
@using System.Text.RegularExpressions
@using System.Text.Json
@using NHA.Website.Software.Entities.Anime
@using NHA.Website.Software.Services.RepositoryPatternFoundationals
@inject IUnitOfWork UnitOfWork

@{
    ViewData["Title"] = "Rankings";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var anime = (await UnitOfWork.AnimePageRepository.FindWithoutTrackingAsync(static animePage => true)).ToList();
    static IEnumerable<string> ParseSegments(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? Enumerable.Empty<string>()
            : value.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(segment => !string.IsNullOrWhiteSpace(segment));
    }

    static string StripHtml(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var cleaned = Regex.Replace(value, "<.*?>", " ");
        return Regex.Replace(cleaned, @"\s+", " ").Trim();
    }

    static string Truncate(string value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length <= maxLength)
        {
            return value;
        }

        return value[..maxLength].TrimEnd() + "…";
    }

    static int NetVotes(AnimePage animePage) => animePage.UpVotes - animePage.DownVotes;

    static double SafeJikan(AnimePage animePage) => animePage.AnimeJikanScore is > 0 ? animePage.AnimeJikanScore.Value : 0;

    static double HybridScore(AnimePage animePage)
    {
        var scoreBoost = SafeJikan(animePage) * 10;
        var communityBoost = NetVotes(animePage) * 2;
        var featuredBoost = animePage.Featured ? 12 : 0;
        var airingBoost = string.Equals(animePage.AnimeStatus, "Currently Airing", StringComparison.OrdinalIgnoreCase) ? 6 : 0;

        return scoreBoost + communityBoost + featuredBoost + airingBoost;
    }

    string StatusTone(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "bg-secondary-subtle text-secondary-emphasis";
        }

        if (status.Contains("airing", StringComparison.OrdinalIgnoreCase))
        {
            return "bg-primary-subtle text-primary-emphasis";
        }

        if (status.Contains("finished", StringComparison.OrdinalIgnoreCase))
        {
            return "bg-success-subtle text-success-emphasis";
        }

        if (status.Contains("upcoming", StringComparison.OrdinalIgnoreCase) || status.Contains("not yet", StringComparison.OrdinalIgnoreCase))
        {
            return "bg-warning-subtle text-warning-emphasis";
        }

        return "bg-secondary-subtle text-secondary-emphasis";
    }

    string BuildSearchData(AnimePage animePage)
    {
        var searchParts = new[]
        {
            animePage.AnimeName,
            StripHtml(animePage.AnimeSummary),
            animePage.AnimeGenres,
            animePage.Platforms,
            animePage.AnimeStatus
        };

        return string.Join(" ", searchParts.Where(text => !string.IsNullOrWhiteSpace(text))).ToLowerInvariant();
    }

    var rankedAnime = anime
        .OrderByDescending(animePage => HybridScore(animePage))
        .ThenByDescending(animePage => SafeJikan(animePage))
        .ThenByDescending(animePage => NetVotes(animePage))
        .ThenBy(animePage => animePage.AnimeName)
        .ToList();

    var topThree = rankedAnime.Take(3).ToList();

    var allGenres = anime
        .SelectMany(animePage => ParseSegments(animePage.AnimeGenres))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value)
        .ToList();

    var allStatuses = anime
        .Select(animePage => animePage.AnimeStatus?.Trim())
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value)
        .ToList();

    var averageJikanScore = anime
        .Where(animePage => animePage.AnimeJikanScore is > 0)
        .Select(animePage => animePage.AnimeJikanScore!.Value)
        .DefaultIfEmpty(0)
        .Average();

    var featuredCount = anime.Count(animePage => animePage.Featured);
    var currentlyAiringCount = anime.Count(animePage => string.Equals(animePage.AnimeStatus, "Currently Airing", StringComparison.OrdinalIgnoreCase));
    var hiddenGemCount = anime.Count(animePage => SafeJikan(animePage) >= 7.5 && NetVotes(animePage) <= 5);
    const int initialRenderCount = 48;
    var rankingDetailBaseUrl = Url.Action("AnimePageDetails", "Anime") ?? "/Anime/AnimePageDetails";
    var rankingGenreBaseUrl = Url.Action("GenreIndex", "Anime") ?? "/Anime/GenreIndex";
    var rankingClientItems = rankedAnime
        .Select(animePage =>
        {
            var previewText = Truncate(StripHtml(animePage.AnimeSummary), 180);
            var statusLabel = string.IsNullOrWhiteSpace(animePage.AnimeStatus) ? "Status unknown" : animePage.AnimeStatus!;

            return new
            {
                id = animePage.Id,
                title = animePage.AnimeName,
                search = BuildSearchData(animePage),
                status = statusLabel.ToLowerInvariant(),
                statusLabel,
                genres = ParseSegments(animePage.AnimeGenres).Take(3).ToArray(),
                genreTokens = ParseSegments(animePage.AnimeGenres).Select(segment => segment.ToLowerInvariant()).ToArray(),
                featured = animePage.Featured,
                imageUrl = animePage.AnimeImageUrl,
                jikan = SafeJikan(animePage),
                upvotes = animePage.UpVotes,
                downvotes = animePage.DownVotes,
                net = NetVotes(animePage),
                hybrid = HybridScore(animePage),
                episodeCount = animePage.EpisodeCount,
                platformPreview = string.Join(", ", ParseSegments(animePage.Platforms).Take(2)),
                previewText = string.IsNullOrWhiteSpace(previewText)
                    ? "No synopsis has been added yet, so let the stats guide the vibe check."
                    : previewText
            };
        })
        .ToList();
    var rankingClientJson = JsonSerializer.Serialize(rankingClientItems);
}

