</style>

<div class="anime-rankings-page d-flex flex-column gap-4">
    @if (topThree.Count > 0)
    {
        <section>
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
                <div>
                    <h2 class="h4 fw-bold mb-1">Spotlight</h2>
                </div>
            </div>

            <div class="row g-3">
                @for (var i = 0; i < topThree.Count; i++)
                {
                    var animePage = topThree[i];
                    var previewText = Truncate(StripHtml(animePage.AnimeSummary), 140);
                    var statusLabel = string.IsNullOrWhiteSpace(animePage.AnimeStatus) ? "Status unknown" : animePage.AnimeStatus!;
                    var podiumGenres = ParseSegments(animePage.AnimeGenres).Take(2).ToList();

                    <div class="col-12 col-md-4">
                        <article class="podium-card podium-card--@(i + 1) d-flex flex-column gap-3 position-relative">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="bg-body-secondary fw-semibold text-body-emphasis border px-2 py-1 border-light-subtle rounded-pill position-relative flex-shrink-0 rank-pill">#@(i + 1)</span>
                                @if (animePage.Featured)
                                {
                                    <span class="badge text-bg-danger rounded-pill">Featured</span>
                                }
                            </div>

                            <div class="podium-poster">
                                @if (!string.IsNullOrWhiteSpace(animePage.AnimeImageUrl))
                                {
                                    <img src="@animePage.AnimeImageUrl" alt="@animePage.AnimeName poster" loading="lazy" />
                                }
                                else
                                {
                                    <div class="podium-poster-placeholder">
                                        <i class="bi bi-stars fs-1"></i>
                                        <span>No artwork yet</span>
                                    </div>
                                }
                            </div>

                            <div class="podium-card__body">
                                <h3 class="h5 fw-bold mb-1">@animePage.AnimeName</h3>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="badge rounded-pill @StatusTone(statusLabel)">@statusLabel</span>
                                    @if (animePage.AnimeJikanScore is > 0)
                                    {
                                        <span class="badge text-bg-warning rounded-pill">Jikan @SafeJikan(animePage).ToString("0.0")</span>
                                    }
                                    <span class="badge text-bg-primary rounded-pill">Net @(NetVotes(animePage) >= 0 ? "+" : string.Empty)@NetVotes(animePage)</span>
                                </div>
                                <p class="text-body-secondary mb-3">@(string.IsNullOrWhiteSpace(previewText) ? "No synopsis yet, but the stats say this one belongs on your radar." : previewText)</p>
                                @if (podiumGenres.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        @for (var genreIndex = 0; genreIndex < podiumGenres.Count; genreIndex++)
                                        {
                                            var genre = podiumGenres[genreIndex];
                                            var genreTone = genreIndex switch
                                            {
                                                0 => "bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill",
                                                1 => "bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill",
                                                2 => "bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill",
                                                _ => "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill"
                                            };
                                            <a asp-action="GenreIndex" asp-controller="Anime" asp-route-genre="@genre" class="ranking-chip-link">
                                                <span class="badge interactable ranking-chip @genreTone">@genre</span>
                                            </a>
                                        }
                                    </div>
                                }
                                <a asp-action="AnimePageDetails" asp-controller="Anime" asp-route-id="@animePage.Id" class="btn btn-outline-primary interactable podium-card__action">View details</a>
                            </div>

                            <a asp-action="AnimePageDetails" asp-controller="Anime" asp-route-id="@animePage.Id" class="stretched-link" aria-label="View details for @animePage.AnimeName"></a>
                        </article>
                    </div>
                }
            </div>
        </section>
    }

    <section class="card border-0 shadow-sm rankings-surface">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h2 class="h4 fw-bold mb-1">Filter</h2>
                </div>

                <div class="d-flex flex-wrap gap-2 view-toggle-group" role="group" aria-label="Ranking layout toggle">
                    <button type="button" class="btn btn-outline-primary active js-view-toggle" data-view="grid">Cards</button>
                    <button type="button" class="btn btn-outline-primary js-view-toggle" data-view="compact">Compact</button>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-lg-4">
                    <label class="form-label fw-semibold" for="animeRankingSearch">Search</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input id="animeRankingSearch" class="form-control" type="search" placeholder="Search by title, genre, summary, or platform" />
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <label class="form-label fw-semibold" for="rankingGenre">Genre</label>
                    <select id="rankingGenre" class="form-select">
                        <option value="">All genres</option>
                        @foreach (var genre in allGenres)
                        {
                            <option value="@genre.ToLowerInvariant()">@genre</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label fw-semibold" for="rankingStatus">Status</label>
                    <select id="rankingStatus" class="form-select">
                        <option value="">Any status</option>
                        @foreach (var status in allStatuses)
                        {
                            <option value="@status!.ToLowerInvariant()">@status</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-lg-3">
                    <label class="form-label fw-semibold" for="rankingSort">Sort by</label>
                    <select id="rankingSort" class="form-select">
                        <option value="hybrid">Hybrid score</option>
                        <option value="jikan">Jikan score</option>
                        <option value="community">Net votes</option>
                        <option value="upvotes">Upvotes</option>
                        <option value="alphabetical">Alphabetical</option>
                    </select>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 mt-3 quick-filter-group" role="group" aria-label="Quick ranking filters">
                <button type="button" class="btn btn-outline-primary active js-quick-filter" data-filter="all">All</button>
                <button type="button" class="btn btn-outline-primary js-quick-filter" data-filter="featured">Featured</button>
                <button type="button" class="btn btn-outline-primary js-quick-filter" data-filter="airing">Currently Airing</button>
                <button type="button" class="btn btn-outline-primary js-quick-filter" data-filter="hidden-gems">Hidden Gems <span class="badge text-bg-secondary ms-1">@hiddenGemCount</span></button>
                <button type="button" id="rankingResetButton" class="btn btn-outline-secondary ms-lg-auto">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                </button>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
                <div id="rankingResultsText" class="small text-body-secondary">Showing @Math.Min(initialRenderCount, rankedAnime.Count) of @rankedAnime.Count anime.</div>
            </div>
        </div>
    </section>

    <section>
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
            <div>
                <h2 class="h4 fw-bold mb-1">Live leaderboard</h2>
                <p class="text-body-secondary mb-0">The ranks below update instantly when you search, filter, or change the scoring mode.</p>
            </div>
        </div>

        <div id="rankingGrid" class="rankings-grid" data-initial-render-count="@initialRenderCount"></div>

        <div id="rankingLoadMoreContainer" class="d-flex justify-content-center mt-3 d-none">
            <button type="button" id="rankingLoadMoreButton" class="btn btn-outline-primary">Load more results</button>
        </div>

        <noscript>
            <div class="alert alert-secondary mt-3 mb-0">Enable JavaScript to browse the live leaderboard.</div>
        </noscript>

        <script id="rankingData" type="application/json">@Html.Raw(rankingClientJson)</script>
        <script id="rankingDetailBaseUrl" type="application/json">@Html.Raw(JsonSerializer.Serialize(rankingDetailBaseUrl))</script>
        <script id="rankingGenreBaseUrl" type="application/json">@Html.Raw(JsonSerializer.Serialize(rankingGenreBaseUrl))</script>

        <div id="rankingEmptyState" class="card border-0 shadow-sm rankings-surface d-none mt-3">
            <div class="card-body p-4 text-center">
                <i class="bi bi-emoji-frown fs-1 d-block mb-3 text-body-secondary"></i>
                <h3 class="h5 fw-bold">No anime matched those filters.</h3>
                <p class="text-body-secondary mb-0">Try clearing the search or switching the quick filter to bring more shows back into the arena.</p>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const container = document.getElementById('rankingGrid');
            const rankingDataElement = document.getElementById('rankingData');
            const rankingDetailBaseUrlElement = document.getElementById('rankingDetailBaseUrl');
            const rankingGenreBaseUrlElement = document.getElementById('rankingGenreBaseUrl');
            if (!container) {
                return;
            }

            const rankingData = rankingDataElement ? JSON.parse(rankingDataElement.textContent || '[]') : [];
            const detailBaseUrl = rankingDetailBaseUrlElement ? JSON.parse(rankingDetailBaseUrlElement.textContent || '"/Anime/AnimePageDetails"') : '/Anime/AnimePageDetails';
            const genreBaseUrl = rankingGenreBaseUrlElement ? JSON.parse(rankingGenreBaseUrlElement.textContent || '"/Anime/GenreIndex"') : '/Anime/GenreIndex';
            const searchInput = document.getElementById('animeRankingSearch');
            const genreSelect = document.getElementById('rankingGenre');
            const statusSelect = document.getElementById('rankingStatus');
            const sortSelect = document.getElementById('rankingSort');
            const resetButton = document.getElementById('rankingResetButton');
            const resultsText = document.getElementById('rankingResultsText');
            const emptyState = document.getElementById('rankingEmptyState');
            const leaderName = document.getElementById('currentLeaderName');
            const leaderMeta = document.getElementById('currentLeaderMeta');
            const loadMoreContainer = document.getElementById('rankingLoadMoreContainer');
            const loadMoreButton = document.getElementById('rankingLoadMoreButton');
            const quickFilters = Array.from(document.querySelectorAll('.js-quick-filter'));
            const viewToggles = Array.from(document.querySelectorAll('.js-view-toggle'));
            const totalCount = rankingData.length;
            const initialRenderCount = Number.parseInt(container.dataset.initialRenderCount || '48', 10);
            const renderBatchSize = initialRenderCount;
            const collator = new Intl.Collator(undefined, { sensitivity: 'base', numeric: true });

            let activeQuickFilter = 'all';
            let renderLimit = initialRenderCount;
            let searchDebounceHandle;

            const numericValue = (item, key) => Number.parseFloat(item[key] || '0');
            const textValue = (item, key) => (item[key] || '').toLowerCase();

            function escapeHtml(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function statusToneClass(status) {
                const normalizedStatus = (status || '').toLowerCase();

                if (!normalizedStatus) {
                    return 'bg-secondary-subtle text-secondary-emphasis';
                }

                if (normalizedStatus.includes('airing')) {
                    return 'bg-primary-subtle text-primary-emphasis';
                }

                if (normalizedStatus.includes('finished')) {
                    return 'bg-success-subtle text-success-emphasis';
                }

                if (normalizedStatus.includes('upcoming') || normalizedStatus.includes('not yet')) {
                    return 'bg-warning-subtle text-warning-emphasis';
                }

                return 'bg-secondary-subtle text-secondary-emphasis';
            }

            function buildDetailUrl(id) {
                const separator = detailBaseUrl.includes('?') ? '&' : '?';
                return `${detailBaseUrl}${separator}id=${encodeURIComponent(id)}`;
            }

            function buildGenreUrl(genre) {
                const separator = genreBaseUrl.includes('?') ? '&' : '?';
                return `${genreBaseUrl}${separator}genre=${encodeURIComponent(genre)}`;
            }

            function genreToneClass(index) {
                switch (index) {
                    case 0:
                        return 'bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill';
                    case 1:
                        return 'bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill';
                    case 2:
                        return 'bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill';
                    default:
                        return 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill';
                }
            }

            function renderCard(item, index) {
                const safeTitle = escapeHtml(item.title);
                const safeStatusLabel = escapeHtml(item.statusLabel || 'Status unknown');
                const safePreview = escapeHtml(item.previewText);
                const safePlatformPreview = escapeHtml(item.platformPreview || '');
                const netPrefix = item.net >= 0 ? '+' : '';
                const posterMarkup = item.imageUrl
                    ? `<img src="${escapeHtml(item.imageUrl)}" alt="${safeTitle} poster" loading="lazy" decoding="async" />`
                    : `<div class="ranking-poster-placeholder"><i class="bi bi-camera-reels fs-1"></i><span>No artwork</span></div>`;
                const jikanMarkup = item.jikan > 0
                    ? `<span class="badge text-bg-warning rounded-pill">Jikan ${item.jikan.toFixed(1)}</span>`
                    : '';
                const featuredMarkup = item.featured
                    ? '<span class="badge text-bg-danger rounded-pill">Featured</span>'
                    : '';
                const genreMarkup = Array.isArray(item.genres) && item.genres.length
                    ? `<div class="d-flex flex-wrap gap-2 mb-3">${item.genres.map((genre, genreIndex) => `<a href="${buildGenreUrl(genre)}" class="ranking-chip-link"><span class="badge interactable ranking-chip ${genreToneClass(genreIndex)}">${escapeHtml(genre)}</span></a>`).join('')}</div>`
                    : '';
                const platformMarkup = safePlatformPreview
                    ? `<span><i class="bi bi-play-btn-fill me-1"></i>${safePlatformPreview}</span>`
                    : '';

                return `
                    <article class="ranking-card interactable-small position-relative">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <span class="bg-body-secondary fw-semibold text-body-emphasis border px-2 py-1 border-light-subtle rounded-pill position-relative flex-shrink-0 rank-pill">#<span class="js-rank-number">${index + 1}</span></span>
                            <div class="d-flex flex-wrap gap-2 justify-content-end">
                                <span class="badge rounded-pill ${statusToneClass(item.status)}">${safeStatusLabel}</span>
                                ${featuredMarkup}
                            </div>
                        </div>

                        <div class="ranking-card__content">
                            <div class="ranking-card__media">
                                ${posterMarkup}
                            </div>

                            <div class="d-flex flex-column h-100">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h3 class="h5 fw-bold mb-1">${safeTitle}</h3>
                                        <div class="small text-body-secondary">${item.episodeCount} episode${item.episodeCount === 1 ? '' : 's'}</div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                                        ${jikanMarkup}
                                        <span class="badge text-bg-primary rounded-pill">Net ${netPrefix}${item.net}</span>
                                    </div>
                                </div>

                                <p class="ranking-summary text-body-secondary mb-3">${safePreview}</p>

                                ${genreMarkup}

                                <div class="ranking-card__footer mt-auto pt-3 border-top border-secondary border-opacity-10">
                                    <div class="ranking-card__meta d-flex flex-wrap gap-3 small text-body-secondary">
                                        <span><i class="bi bi-hand-thumbs-up-fill text-success me-1 vote-icon"></i>${item.upvotes}</span>
                                        <span><i class="bi bi-hand-thumbs-down-fill text-danger me-1 vote-icon"></i>${item.downvotes}</span>
                                        ${platformMarkup}
                                    </div>
                                    <a href="${buildDetailUrl(item.id)}" class="btn btn-sm btn-outline-primary interactable ranking-card__action">Open page</a>
                                </div>
                            </div>
                        </div>

                        <a href="${buildDetailUrl(item.id)}" class="stretched-link" aria-label="Open ${safeTitle} details"></a>
                    </article>`;
            }

            function syncActiveButtons(buttons, activeValue, attributeName) {
                buttons.forEach(button => {
                    button.classList.toggle('active', button.dataset[attributeName] === activeValue);
                });
            }

            function matchesQuickFilter(item) {
                switch (activeQuickFilter) {
                    case 'featured':
                        return Boolean(item.featured);
                    case 'airing':
                        return textValue(item, 'status').includes('airing');
                    case 'hidden-gems':
                        return numericValue(item, 'jikan') >= 7.5 && numericValue(item, 'net') <= 5;
                    default:
                        return true;
                }
            }

            function matchesFilters(item) {
                const searchTerm = (searchInput.value || '').trim().toLowerCase();
                const selectedGenre = (genreSelect.value || '').toLowerCase();
                const selectedStatus = (statusSelect.value || '').toLowerCase();
                const searchableText = textValue(item, 'search');
                const genres = Array.isArray(item.genreTokens) ? item.genreTokens : [];
                const status = textValue(item, 'status');

                if (searchTerm && !searchableText.includes(searchTerm)) {
                    return false;
                }

                if (selectedGenre && !genres.includes(selectedGenre)) {
                    return false;
                }

                if (selectedStatus && status !== selectedStatus) {
                    return false;
                }

                return matchesQuickFilter(item);
            }

            function compareItems(left, right) {
                switch (sortSelect.value) {
                    case 'jikan':
                        return numericValue(right, 'jikan') - numericValue(left, 'jikan') || collator.compare(left.title || '', right.title || '');
                    case 'community':
                        return numericValue(right, 'net') - numericValue(left, 'net') || collator.compare(left.title || '', right.title || '');
                    case 'upvotes':
                        return numericValue(right, 'upvotes') - numericValue(left, 'upvotes') || collator.compare(left.title || '', right.title || '');
                    case 'alphabetical':
                        return collator.compare(left.title || '', right.title || '');
                    default:
                        return numericValue(right, 'hybrid') - numericValue(left, 'hybrid') || collator.compare(left.title || '', right.title || '');
                }
            }

            function updateLeader(visibleItems) {
                if (!leaderName || !leaderMeta) {
                    return;
                }

                if (!visibleItems.length) {
                    leaderName.textContent = 'No anime found';
                    leaderMeta.textContent = 'Adjust the filters to bring the leaderboard back.';
                    return;
                }

                const leaderItem = visibleItems[0];
                const leaderScore = numericValue(leaderItem, 'jikan').toFixed(1);
                const leaderNet = numericValue(leaderItem, 'net');
                const statusLabel = leaderItem.statusLabel || 'Status unknown';
                const netPrefix = leaderNet >= 0 ? '+' : '';

                leaderName.textContent = leaderItem.title || 'Anime spotlight';
                leaderMeta.textContent = `Net ${netPrefix}${leaderNet} • Jikan ${leaderScore} • ${statusLabel}`;
            }

            function render() {
                const visibleItems = rankingData.filter(matchesFilters).sort(compareItems);
                const renderedItems = visibleItems.slice(0, renderLimit);

                container.innerHTML = renderedItems.map((item, index) => renderCard(item, index)).join('');

                if (resultsText) {
                    if (visibleItems.length) {
                        const prefix = visibleItems.length > renderedItems.length
                            ? `Showing ${renderedItems.length} of ${visibleItems.length} matching anime`
                            : `Showing ${visibleItems.length} of ${visibleItems.length} matching anime`;
                        resultsText.textContent = `${prefix} (${totalCount} total).`;
                    } else {
                        resultsText.textContent = 'No anime matched the current filters.';
                    }
                }

                if (emptyState) {
                    emptyState.classList.toggle('d-none', visibleItems.length !== 0);
                }

                if (loadMoreContainer && loadMoreButton) {
                    const hasMoreResults = visibleItems.length > renderedItems.length;
                    loadMoreContainer.classList.toggle('d-none', !hasMoreResults);
                    loadMoreButton.textContent = hasMoreResults
                        ? `Load more results (${visibleItems.length - renderedItems.length} remaining)`
                        : 'Load more results';
                }

                updateLeader(visibleItems);
            }

            quickFilters.forEach(button => {
                button.addEventListener('click', function () {
                    activeQuickFilter = button.dataset.filter || 'all';
                    renderLimit = initialRenderCount;
                    syncActiveButtons(quickFilters, activeQuickFilter, 'filter');
                    render();
                });
            });

            viewToggles.forEach(button => {
                button.addEventListener('click', function () {
                    const nextView = button.dataset.view || 'grid';
                    container.classList.toggle('rankings-grid--compact', nextView === 'compact');
                    syncActiveButtons(viewToggles, nextView, 'view');
                });
            });

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    window.clearTimeout(searchDebounceHandle);
                    searchDebounceHandle = window.setTimeout(function () {
                        renderLimit = initialRenderCount;
                        render();
                    }, 120);
                });
            }

            [genreSelect, statusSelect, sortSelect].forEach(element => {
                if (!element) {
                    return;
                }

                element.addEventListener('change', function () {
                    renderLimit = initialRenderCount;
                    render();
                });
            });

            if (loadMoreButton) {
                loadMoreButton.addEventListener('click', function () {
                    renderLimit += renderBatchSize;
                    render();
                });
            }

            if (resetButton) {
                resetButton.addEventListener('click', function () {
                    searchInput.value = '';
                    genreSelect.value = '';
                    statusSelect.value = '';
                    sortSelect.value = 'hybrid';
                    activeQuickFilter = 'all';
                    renderLimit = initialRenderCount;
                    container.classList.remove('rankings-grid--compact');
                    syncActiveButtons(quickFilters, activeQuickFilter, 'filter');
                    syncActiveButtons(viewToggles, 'grid', 'view');
                    render();
                });
            }

            syncActiveButtons(quickFilters, activeQuickFilter, 'filter');
            syncActiveButtons(viewToggles, 'grid', 'view');
            render();
        });
    </script>
}