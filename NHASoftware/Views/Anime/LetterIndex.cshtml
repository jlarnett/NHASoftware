@using NHA.Website.Software.Views.Anime.Vms
@model LetterIndexViewModel
@{
    ViewData["Title"] = "Anime";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <link rel="stylesheet" href="~/css/AnimePages.css">
</head>

@{
    var letterAnimeCount = @Model.AnimeList.Count;
}

<h1>@Model.AlphabetLetter <em class="h3 text-primary">(@letterAnimeCount)</em></h1>

@{
    foreach (var anime in Model.AnimeList)
    {
        if (Model.IsEnglish)
        {
            <a asp-action="AnimePage" asp-route-id="@anime.Id" asp-controller="Anime" class="link-primary animepage-links">@anime.AnimeName</a>
        }
        else
        {
            <a asp-action="AnimePage" asp-route-id="@anime.Id" asp-controller="Anime" class="link-primary animepage-links">@anime.AnimeJapaneseName</a>
        }

        <br/>
    }
}
